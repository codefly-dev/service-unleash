apiVersion: v1
kind: Service
metadata:
  name: "{{ .Service.Name.DNSCase }}"
  namespace: "{{ .Namespace }}"
  labels:
    app.kubernetes.io/name: "{{ .Service.Name.DNSCase }}"
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: "{{ .Service.Name.DNSCase }}"
    app.kubernetes.io/component: control
  ports:
    - name: edge
      port: 8080
      targetPort: edge
    - name: admin
      port: 80
      targetPort: admin
